---
# Purpose: assert that the instance really ended up in the expected state.
# Molecule calls this playbook with `molecule verify`.
- name: Verify
  hosts: all
  gather_facts: false
  tasks:
    - name: Check Vector binary exists
      ansible.builtin.stat:
        path: /opt/vector/bin/vector
      register: vector_binary
      failed_when: not vector_binary.stat.exists

    - name: Check Vector service is running
      ansible.builtin.shell: |
        ps aux | grep -v grep | grep vector
      register: vector_process
      failed_when: vector_process.rc != 0
